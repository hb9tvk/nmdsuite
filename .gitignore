staticfiles/
media/
# Both are build output. The image build runs makemessages →
# tools/build_translations.py → compilemessages, and build_translations.py
# rewrites every msgstr from its TRANSLATIONS table — anything not in that
# table is blanked. Add new strings there; a checked-in .po only goes stale.
locale/*/LC_MESSAGES/*.po
locale/*/LC_MESSAGES/*.mo

.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.idea/
.vscode/
*.swp
.DS_Store

# reference/ holds legacy artefacts (rules PDF, TCL scoring app, legacy Flask
# log-submission app). Used locally for development context only — not needed
# to build or run nmdsuite, so it's not pushed to GitHub.
/reference/

# Local validation fixtures (e.g. legacy SQLite dumps for `import_legacy`).
/testdata/

# Personal scratch notes and throwaway test output — not part of the project.
/cheatsheet.txt
/reset.txt
/test_out.txt

# Knowledge pack for the NMD meeting talk — written to be uploaded to a
# Claude.ai project, not part of the application or its documentation.
/presentation/

# Local deploy wrapper. Carries the operator's own Docker host and data path,
# so it lives on the dev box rather than in the repo.
/deploy-local.sh
